    "react": "$react",
    "react-dom": "$react-dom",
    "next": "$next"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^5.22.0",
    "@types/node": "25.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@uiw/react-md-editor": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "easymde": "^2.20.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.2",
    "lucide-react": "^1.8.0",
    "markdown-it": "^14.1.1",
    "next": "^15.5.15",
    "next-auth": "^5.0.0-beta.30",
    "next-sanity": "^11.6.13",
    "postcss": "^8.5.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^5.15.0",
    "sanity-plugin-markdown": "^8.0.5",
    "server-only": "^0.0.1",
    "shadcn": "^4.3.0",
    "styled-components": "^6.4.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss-animate": "^1.0.7"
  }
